# Copy to .env and fill in.
# NEAR AI Cloud key from https://cloud.near.ai
NEAR_AI_API_KEY=

# Ownling contract and the kitchen account that charges pets (testnet)
PETS_CONTRACT=pets.ownling.testnet
KITCHEN_ACCOUNT_ID=
KITCHEN_PRIVATE_KEY=

# Sponsor that creates new players' accounts (<name>.<sponsor>); leave empty to close sign-up
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=

# Optional
# PLAYER_STARTER_NEAR=1
# PET_MODEL=z-ai/glm-5.3-flash
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEAR_USD=3.68
# KITCHEN_MARKUP=1.25
# KITCHEN_MOCK=1          (practice mode: canned replies, no NEAR AI)
# APP_ORIGIN=http://localhost:5173
