{
  "name": "ownling-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ownling game app: an AI pet that owns itself",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:android": "tsc --noEmit && vite build --mode android --outDir dist-android && cap sync android",
    "build:windows": "tsc --noEmit && vite build --mode windows --outDir ../desktop/app --emptyOutDir",
    "demo": "vite --mode mock"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "near-api-js": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0"
  }
}
