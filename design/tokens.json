{
  "$description": "Ownling design tokens. tokens.css mirrors these as CSS variables (--ow-* for the game, --proof-* for proof surfaces).",
  "color": {
    "game": {
      "mist":        { "light": "#F5F2EC", "dark": "#14161B", "role": "App ground" },
      "paper":       { "light": "#FFFFFF", "dark": "#1E2128", "role": "Cards and sheets" },
      "ink":         { "light": "#1F2230", "dark": "#F2F3F8", "role": "Text" },
      "dusk":        { "light": "#5B6072", "dark": "#A9AEBD", "role": "Secondary text" },
      "line":        { "light": "#E4DFD6", "dark": "#2E323C", "role": "Dividers, borders" },
      "rain":        { "light": "#2D63D8", "dark": "#8AB4FF", "role": "The one accent: main action, user bubbles" },
      "onRain":      { "light": "#FFFFFF", "dark": "#0F1A33", "role": "Text on rain" },
      "puddle":      { "light": "#E3ECFD", "dark": "#1F2A44", "role": "Accent wash, Mochi bubbles" },
      "blush":       { "light": "#F4A3AE", "dark": "#F4A3AE", "role": "Cheeks, gifts" },
      "proof":       { "light": "#1A6B48", "dark": "#85C9A1", "role": "Verified tag" },
      "proofWash":   { "light": "#E7F3EC", "dark": "#17342A" },
      "drizzle":     { "light": "#A8690F", "dark": "#FFC75C", "role": "Pending, low food" },
      "drizzleWash": { "light": "#FFF4DE", "dark": "#3A2F17" },
      "storm":       { "light": "#D0342C", "dark": "#FF6B6B", "role": "Errors, very hungry" },
      "sleep":       { "light": "#5D6475", "dark": "#A9AEBD", "role": "Hibernating" }
    },
    "proofSurface": {
      "ground": { "light": "#FFFFFF", "dark": "#111113" },
      "panel":  { "light": "#F6F6F7", "dark": "#1B1B1E" },
      "ink":    { "light": "#1D1D1F", "dark": "#F2F3F8" },
      "muted":  { "light": "#5F6068", "dark": "#A7A8B0" },
      "line":   { "light": "#E3E3E6", "dark": "#2C2C31" },
      "accent": { "light": "#035CA3", "dark": "#7EBCFF" }
    },
    "mochi": {
      "outline": "#2B3145", "outlineSleep": "#7E8597", "bodyLight": "#FFFFFF", "bodyShade": "#D3DEF6",
      "sleepLight": "#E2E5EB", "sleepShade": "#B3B9C6", "wisp": "#8DB4F2", "blush": "#F4A3AE",
      "tongue": "#E8737F", "rain": "#6AA6F2", "sparkle": "#F2B33D",
      "$note": "Mochi's art uses the same colors on light and dark grounds; the ink outline carries it."
    },
    "moodDot": { "content": "#1A6B48", "peckish": "#A8690F", "hungry": "#D0342C", "hibernating": "#5D6475" }
  },
  "font": {
    "game": "Nunito",
    "proof": "Schibsted Grotesk",
    "mono": "JetBrains Mono",
    "$rule": "Mono only for amounts, account names and hashes."
  },
  "type": {
    "display": { "size": 38, "weight": 900, "lineHeight": 1.05 },
    "title":   { "size": 28, "weight": 900, "lineHeight": 1.1 },
    "meter":   { "size": 18, "weight": 800, "lineHeight": 1.3 },
    "body":    { "size": 16, "weight": 400, "lineHeight": 1.45 },
    "button":  { "size": 17, "weight": 800 },
    "small":   { "size": 13, "weight": 400, "lineHeight": 1.45 }
  },
  "radius": { "sheet": 28, "card": 22, "tile": 20, "bubble": 20, "bubbleTail": 6, "field": 14, "pill": 999,
              "proofPane": 20, "proofCard": 16, "proofControl": 11 },
  "size": { "gutter": 20, "touch": 44, "button": 54, "actionTile": 64, "phoneFrame": [390, 844] },
  "motion": {
    "float":  { "duration": "3.6s", "distance": "6px", "easing": "ease-in-out" },
    "bounce": { "duration": "1.1s", "distance": "16px" },
    "eatingHold": "1.5s",
    "playCooldown": "10m",
    "$rule": "Respect prefers-reduced-motion: no float, bounce or pulsing dots."
  }
}
