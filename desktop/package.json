{
  "name": "ownling-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Ownling for Windows: the game in its own window, carrying its own copy of the app",
  "main": "main.cjs",
  "author": "04-John",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ownling.app",
    "productName": "Ownling",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": ["en-US"],
    "compression": "maximum",
    "files": ["main.cjs", "app/**/*"],
    "directories": { "output": "release", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "Ownling-Setup.exe" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ownling",
      "runAfterFinish": true
    }
  }
}
